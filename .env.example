# MongoDB Atlas connection
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=fraud_emails

# Path to the PST file
PST_FILE_PATH=Gmail Lawsuit Exportes Email.pst

# Ingestion tuning
BATCH_SIZE=100
MAX_BODY_CHARS=2000000
ATTACHMENT_MAX_BYTES=52428800

# Will be used in later phases (Phase 2+)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
