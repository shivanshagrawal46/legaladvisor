# ============================================================================
# REAL-TIME GMAIL PUSH — keys to ADD to the DO server's existing .env
# ============================================================================
# settings.py loads the repo-root .env with override=True, so .env is the
# single source of truth. DO NOT make a separate file — just append the block
# below to /opt/outlook_attachments/.env
#
# These MUST already be present in that .env (the API/pipeline needs them —
# do NOT duplicate/change, just confirm they exist and are non-empty):
#   MONGO_URI=...
#   MONGO_DB_NAME=fraud_emails
#   PST_FILE_PATH=...            # required by Settings.load() (any path string; file need not exist on the box)
#   ANTHROPIC_API_KEY=...
#   VOYAGE_API_KEY=...
#   OPENAI_API_KEY=...
#
# ---------------------------------------------------------------------------
# >>> APPEND EXACTLY THIS BLOCK to /opt/outlook_attachments/.env <<<
# ---------------------------------------------------------------------------

# Gmail OAuth (copy client_secret.json + gmail_token.json from the laptop)
GMAIL_CLIENT_SECRET=/opt/outlook_attachments/client_secret.json
GMAIL_TOKEN_PATH=/opt/outlook_attachments/gmail_token.json

# Pub/Sub — worker's service-account key (copy the mango-500409-*.json here)
GOOGLE_APPLICATION_CREDENTIALS=/opt/outlook_attachments/pubsub-sa.json

# Pub/Sub topic + subscription (project mango-500409 — already created)
GMAIL_PUBSUB_TOPIC=projects/mango-500409/topics/gmail-boris
PUBSUB_SUBSCRIPTION=projects/mango-500409/subscriptions/gmail-boris-sub
